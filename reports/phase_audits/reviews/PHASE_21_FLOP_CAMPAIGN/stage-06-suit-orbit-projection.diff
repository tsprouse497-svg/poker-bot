+    /// Keep CFR exactly suit-symmetric: give every hand the chance-node value
+    /// of the lowest-index hand in its orbit under the suit permutations that
+    /// fix the board and the cards dealt so far.
+    ///
+    /// Those hands are the same hand, so in exact arithmetic this changes
+    /// nothing. In f32 it does: `chance_node` adds each hand's per-card values
+    /// in card order, which is a different order for each member of an orbit,
+    /// so members come back a few ulps apart. Regret accumulates that gap every
+    /// iteration, and near-indifferent hands turn it into visibly different
+    /// strategies. With isomorphism on, the gap also lines up with suit order
+    /// (the orbit representative is always the lowest card); with it off the
+    /// gap is just as large but unordered. Measured on monotone boards: suit
+    /// variants up to 1.5e-2 apart on a turn root and 1.4e-3 on a flop root at
+    /// 300 iterations, not settling as iterations rise. Copying one member's
+    /// value onto the rest makes the members bitwise equal, so the gap is
+    /// never created. Summing the cards in f64 also removes it in practice,
+    /// but only this copy guarantees it.
+    ///
+    /// Only the CFR traversal is projected; best response keeps its own values
+    /// and so still measures the strategy honestly. Skipped when node locks are
+    /// set, since a lock can make suit-variant hands genuinely different.
+    fn project_onto_suit_orbits(&self, p: usize, dealt: &Dealt, out: &mut [f32]) {
+        if self.orbit_canon.is_empty() || !self.locks.is_empty() {
+            return;
+        }
+        let spot = &*self.spot;
+        let mut mask = 0u32;
+        for (k, pm) in spot.suit_perms.iter().enumerate() {
+            if (0..dealt.len as usize)
+                .all(|i| crate::cards::permute_card(dealt.cards[i], pm) == dealt.cards[i])
+            {
+                mask |= 1u32 << k;
+            }
+        }
+        // A stabilizer of one element (only the identity) has no table.
+        let Some((_, canon)) = self.orbit_canon.iter().find(|(m, _)| *m == mask) else {
+            return;
+        };
+        // The canonical member is the orbit's lowest index and maps to
+        // itself, so it is never overwritten before it is read.
+        for (i, &j) in canon[p].iter().enumerate() {
+            out[i] = out[j as usize];
+        }
+    }
