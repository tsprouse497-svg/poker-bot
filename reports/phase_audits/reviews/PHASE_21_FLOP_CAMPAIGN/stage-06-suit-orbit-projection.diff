+
+/// Hands that the board's suit group maps onto each other are the same hand,
+/// so CFR must give them bitwise-identical strategies. On a monotone turn the
+/// group swaps the three other suits; before the orbit projection in
+/// `Solver::cfr`, f32 summation order at the river chance node seeded a gap
+/// and the orbit-representative synthesis grew it along suit order.
+#[test]
+fn suit_variants_get_identical_strategies() {
+    let config = SpotConfig {
+        board: "9c8c7c2c".to_string(),
+        range_oop: "TT-55,AJs-A2s,KTs+,QTs+,JTs,T9s,65s,54s,AJo+,KQo".to_string(),
+        range_ip: "AA-22,A2s+,K9s+,Q9s+,J9s+,T8s+,97s+,86s+,75s+,64s+,ATo+,KJo+,QJo".to_string(),
+        tree: TreeConfig {
+            starting_pot: 10.0,
+            effective_stack: 95.0,
+            oop: [sizing("33", "2.5x"), sizing("66", "2.5x"), sizing("66", "2.5x")],
+            ip: [sizing("33", "2.5x"), sizing("66", "2.5x"), sizing("66", "2.5x")],
+            max_raises: 2,
+            ..Default::default()
+        },
+    };
+    let spot = Spot::new(config).unwrap();
+    assert_eq!(spot.suit_perms.len(), 6, "a monotone board admits all three-suit swaps");
+    let mut solver = Solver::new(Arc::new(spot));
+    for _ in 0..150 {
+        solver.iterate();
+    }
+    let spot = solver.spot.clone();
+    // Every turn action node above the river deal.
+    let mut stack = vec![0u32];
+    let mut checked = 0usize;
+    while let Some(idx) = stack.pop() {
+        let node = &spot.tree.nodes[idx as usize];
+        if node.kind != solver::tree::KIND_ACTION {
+            continue;
+        }
+        for a in 0..node.num_children as usize {
+            stack.push(spot.tree.children[node.children_start as usize + a]);
+        }
+        let p = node.player as usize;
+        let nh = spot.hands[p].len();
+        let sigma = solver.average_strategy(idx, node);
+        for i in 0..nh {
+            for k in 0..spot.suit_perms.len() {
+                let j = spot.hand_perm[p][k][i] as usize;
+                for a in 0..node.num_children as usize {
+                    assert_eq!(
+                        sigma[a * nh + i].to_bits(),
+                        sigma[a * nh + j].to_bits(),
+                        "node {idx} action {a}: suit variants {i} and {j} differ ({} vs {})",
+                        sigma[a * nh + i],
+                        sigma[a * nh + j]
+                    );
+                }
+            }
+        }
+        checked += 1;
+    }
+    assert!(checked > 5, "expected several turn action nodes, checked {checked}");
+}
