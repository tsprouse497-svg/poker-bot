+    /// Precompute `orbit_canon` for every stabilizer a traversal can meet:
+    /// those of no dealt card, of one, and of two.
+    fn with_orbit_canon(mut self) -> Solver {
+        let spot = self.spot.clone();
+        let np = spot.suit_perms.len();
+        if np < 2 {
+            return self;
+        }
+        let mut dealts = vec![Dealt::default()];
+        for a in 0..52u8 {
+            if spot.board_mask & (1u64 << a) != 0 {
+                continue;
+            }
+            dealts.push(Dealt::default().push(a));
+            for b in (a + 1)..52u8 {
+                if spot.board_mask & (1u64 << b) == 0 {
+                    dealts.push(Dealt::default().push(a).push(b));
+                }
+            }
+        }
+        for d in &dealts {
+            let valid = spot.perms_fixing(d);
+            let mask = valid.iter().fold(0u32, |m, &k| m | (1u32 << k));
+            if valid.len() < 2 || self.orbit_canon.iter().any(|(m, _)| *m == mask) {
+                continue;
+            }
+            let canon = [0, 1].map(|p| {
+                (0..spot.hands[p].len())
+                    .map(|i| valid.iter().map(|&k| spot.hand_perm[p][k][i]).min().unwrap())
+                    .collect::<Vec<u16>>()
+            });
+            self.orbit_canon.push((mask, canon));
+        }
+        self
     }
 
